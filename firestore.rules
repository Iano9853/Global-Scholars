rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'mulijosephine446@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOnboardingMap(ob) {
      return ob is map
        && ob.keys().hasAll([
          'passportCountry',
          'residenceCountry',
          'educationLanguage',
          'degreeType',
          'broadFields',
          'majors',
          'intakeWindow',
          'completedEducation',
          'gradeSystem',
          'rawGrade',
          'estimatedGpa4',
          'standardizedTests',
          'workStudyPreferences',
          'budgetTier',
          'targetCountries',
          'hasDocsReady',
          'onboardingCompleted'
        ])
        && ob.keys().hasOnly([
          'passportCountry',
          'residenceCountry',
          'educationLanguage',
          'degreeType',
          'broadFields',
          'majors',
          'intakeWindow',
          'completedEducation',
          'gradeSystem',
          'rawGrade',
          'estimatedGpa4',
          'standardizedTests',
          'workStudyPreferences',
          'budgetTier',
          'targetCountries',
          'hasDocsReady',
          'onboardingCompleted'
        ])
        && ob.passportCountry is string && ob.passportCountry.size() <= 80
        && ob.residenceCountry is string && ob.residenceCountry.size() <= 80
        && ob.educationLanguage is string && ob.educationLanguage.size() <= 20
        && ob.degreeType is string && ob.degreeType.size() <= 40
        && ob.broadFields is list && ob.broadFields.size() <= 5
        && (ob.broadFields.size() == 0 || ob.broadFields[0] is string)
        && ob.majors is list && ob.majors.size() <= 3
        && (ob.majors.size() == 0 || ob.majors[0] is string)
        && ob.intakeWindow is string && ob.intakeWindow.size() <= 60
        && ob.completedEducation is string && ob.completedEducation.size() <= 100
        && ob.gradeSystem is string && ob.gradeSystem.size() <= 40
        && ob.rawGrade is string && ob.rawGrade.size() <= 40
        && ob.estimatedGpa4 is number && ob.estimatedGpa4 >= 0 && ob.estimatedGpa4 <= 4.0
        && ob.standardizedTests is list && ob.standardizedTests.size() <= 6
        && (ob.standardizedTests.size() == 0 || ob.standardizedTests[0] is string)
        && ob.workStudyPreferences is list && ob.workStudyPreferences.size() <= 5
        && (ob.workStudyPreferences.size() == 0 || ob.workStudyPreferences[0] is string)
        && ob.budgetTier is string && ob.budgetTier.size() <= 80
        && ob.targetCountries is list && ob.targetCountries.size() <= 12
        && (ob.targetCountries.size() == 0 || ob.targetCountries[0] is string)
        && ob.hasDocsReady is bool
        && ob.onboardingCompleted is bool;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'authProvider', 'onboarding', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'authProvider', 'onboarding', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.authProvider in ['email', 'google']
        && isValidOnboardingMap(data.onboarding)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedProgram(data, userId, programId) {
      return data.keys().hasAll(['userId', 'programId', 'university', 'programTitle', 'deadline', 'createdAt'])
        && data.keys().hasOnly(['userId', 'programId', 'university', 'programTitle', 'deadline', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.programId is string && data.programId == programId && isValidId(data.programId)
        && data.university is string && data.university.size() >= 1 && data.university.size() <= 160
        && data.programTitle is string && data.programTitle.size() >= 1 && data.programTitle.size() <= 220
        && data.deadline is string && data.deadline.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidVaultDocument(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'category', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'category', 'status', 'notes', 'fileName', 'fileSizeBytes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category in ['Identity', 'Academic', 'Financial', 'Language', 'Work Authorization']
        && data.status in ['Ready', 'In Progress', 'Missing']
        && data.notes is string && data.notes.size() <= 500
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 200))
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApplicationSubmission(data, userId, programId) {
      return data.keys().hasAll([
          'userId',
          'programId',
          'university',
          'programTitle',
          'studentName',
          'studentEmail',
          'requirementsAcknowledged',
          'status',
          'emailDispatched',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'programId',
          'university',
          'programTitle',
          'studentName',
          'studentEmail',
          'requirementsAcknowledged',
          'status',
          'emailDispatched',
          'createdAt'
        ])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.programId is string && data.programId == programId && isValidId(data.programId)
        && data.university is string && data.university.size() >= 1 && data.university.size() <= 160
        && data.programTitle is string && data.programTitle.size() >= 1 && data.programTitle.size() <= 220
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 200
        && data.requirementsAcknowledged is bool && data.requirementsAcknowledged == true
        && data.status in ['Official Outreach Requested']
        && data.emailDispatched is bool
        && data.createdAt is timestamp;
    }

    function isValidStudentPortalRecord(data, portalId) {
      return data.keys().hasAll([
          'portalId',
          'studentEmail',
          'studentName',
          'studentIdNumber',
          'portalEmail',
          'portalPasswordHash',
          'university',
          'universityLocation',
          'course',
          'sponsorshipProgramme',
          'grossAnnualFeeUsd',
          'governmentCoveragePercent',
          'governmentCoverageUsd',
          'householdFeeUsd',
          'expectedArrivalDate',
          'intakeTerm',
          'homeGuardianName',
          'homeGuardianRelation',
          'schoolGuardianName',
          'schoolGuardianRole',
          'workStudyRole',
          'workStudyLocation',
          'workStudyHourlyUsd',
          'workStudyHoursPerDay',
          'workStudyDaysPerWeek',
          'enrollmentStatus',
          'academicTranscript',
          'feesLedger',
          'preArrivalChecklist',
          'studentMail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'portalId',
          'studentEmail',
          'studentName',
          'studentIdNumber',
          'portalEmail',
          'portalPasswordHash',
          'university',
          'universityLocation',
          'course',
          'sponsorshipProgramme',
          'grossAnnualFeeUsd',
          'governmentCoveragePercent',
          'governmentCoverageUsd',
          'householdFeeUsd',
          'expectedArrivalDate',
          'intakeTerm',
          'homeGuardianName',
          'homeGuardianRelation',
          'schoolGuardianName',
          'schoolGuardianRole',
          'workStudyRole',
          'workStudyLocation',
          'workStudyHourlyUsd',
          'workStudyHoursPerDay',
          'workStudyDaysPerWeek',
          'enrollmentStatus',
          'academicTranscript',
          'feesLedger',
          'preArrivalChecklist',
          'studentMail',
          'createdAt',
          'updatedAt'
        ])
        && data.portalId is string && data.portalId == portalId && isValidId(data.portalId)
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 200
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentIdNumber is string && data.studentIdNumber.size() >= 1 && data.studentIdNumber.size() <= 60
        && data.portalEmail is string && data.portalEmail.size() >= 3 && data.portalEmail.size() <= 200
        && data.portalPasswordHash is string && data.portalPasswordHash.size() >= 64 && data.portalPasswordHash.size() <= 128
        && data.university is string && data.university.size() >= 1 && data.university.size() <= 160
        && data.universityLocation is string && data.universityLocation.size() >= 1 && data.universityLocation.size() <= 160
        && data.course is string && data.course.size() >= 1 && data.course.size() <= 160
        && data.sponsorshipProgramme is string && data.sponsorshipProgramme.size() >= 1 && data.sponsorshipProgramme.size() <= 220
        && data.grossAnnualFeeUsd is number && data.grossAnnualFeeUsd >= 0
        && data.governmentCoveragePercent is number && data.governmentCoveragePercent >= 0 && data.governmentCoveragePercent <= 100
        && data.governmentCoverageUsd is number && data.governmentCoverageUsd >= 0
        && data.householdFeeUsd is number && data.householdFeeUsd >= 0
        && data.expectedArrivalDate is string && data.expectedArrivalDate.size() >= 1 && data.expectedArrivalDate.size() <= 80
        && data.intakeTerm is string && data.intakeTerm.size() >= 1 && data.intakeTerm.size() <= 80
        && data.homeGuardianName is string && data.homeGuardianName.size() >= 1 && data.homeGuardianName.size() <= 120
        && data.homeGuardianRelation is string && data.homeGuardianRelation.size() >= 1 && data.homeGuardianRelation.size() <= 80
        && data.schoolGuardianName is string && data.schoolGuardianName.size() >= 1 && data.schoolGuardianName.size() <= 120
        && data.schoolGuardianRole is string && data.schoolGuardianRole.size() >= 1 && data.schoolGuardianRole.size() <= 120
        && data.workStudyRole is string && data.workStudyRole.size() >= 1 && data.workStudyRole.size() <= 120
        && data.workStudyLocation is string && data.workStudyLocation.size() >= 1 && data.workStudyLocation.size() <= 160
        && data.workStudyHourlyUsd is number && data.workStudyHourlyUsd >= 0
        && data.workStudyHoursPerDay is number && data.workStudyHoursPerDay >= 0 && data.workStudyHoursPerDay <= 12
        && data.workStudyDaysPerWeek is number && data.workStudyDaysPerWeek >= 0 && data.workStudyDaysPerWeek <= 7
        && data.enrollmentStatus in ['Pre-Arrival', 'Enrolled', 'Active']
        && data.academicTranscript is list && data.academicTranscript.size() <= 20
        && (data.academicTranscript.size() == 0 || data.academicTranscript[0] is map)
        && data.feesLedger is list && data.feesLedger.size() <= 20
        && (data.feesLedger.size() == 0 || data.feesLedger[0] is map)
        && data.preArrivalChecklist is list && data.preArrivalChecklist.size() <= 15
        && (data.preArrivalChecklist.size() == 0 || data.preArrivalChecklist[0] is map)
        && data.studentMail is list && data.studentMail.size() <= 50
        && (data.studentMail.size() == 0 || data.studentMail[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().authProvider == existing().authProvider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'onboarding', 'updatedAt']);

      match /savedPrograms/{programId} {
        allow get: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId)
          && isValidSavedProgram(incoming(), userId, programId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId);
      }

      match /vaultDocuments/{docId} {
        allow get: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidVaultDocument(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidVaultDocument(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'status', 'notes', 'fileName', 'fileSizeBytes', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(docId);
      }

      match /applications/{programId} {
        allow get: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId)
          && isValidApplicationSubmission(incoming(), userId, programId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(programId);
      }
    }

    match /studentPortals/{portalId} {
      allow get: if isAdmin()
        || (isVerifiedUser()
          && isValidId(portalId)
          && existing().studentEmail.lower() == request.auth.token.email.lower());
      allow list: if isAdmin() && resource.data.studentEmail is string;
      allow create: if isAdmin()
        && isValidId(portalId)
        && isValidStudentPortalRecord(incoming(), portalId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(portalId)
        && isValidStudentPortalRecord(incoming(), portalId)
        && incoming().portalId == existing().portalId
        && incoming().studentEmail == existing().studentEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(portalId);
    }
  }
}
