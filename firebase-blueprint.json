{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile and academic/work-study onboarding preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "authProvider": {
          "type": "string",
          "enum": ["email", "google"]
        },
        "onboarding": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "authProvider", "onboarding", "createdAt", "updatedAt"]
    },
    "SavedProgram": {
      "title": "SavedProgram",
      "description": "A scholarship or work-study program bookmarked by a student in their tracker.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "university": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "programTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "deadline": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "programId", "university", "programTitle", "deadline", "createdAt"]
    },
    "VaultDocument": {
      "title": "VaultDocument",
      "description": "An applicant document record explicitly created or attached by the student.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["Identity", "Academic", "Financial", "Language", "Work Authorization"]
        },
        "status": {
          "type": "string",
          "enum": ["Ready", "In Progress", "Missing"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "fileName": {
          "type": "string",
          "maxLength": 200
        },
        "fileSizeBytes": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "category", "status", "notes", "createdAt", "updatedAt"]
    },
    "ApplicationSubmission": {
      "title": "ApplicationSubmission",
      "description": "Confirmed school selection where the student acknowledged requirements and requested official admissions outreach.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "university": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "programTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "requirementsAcknowledged": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["Official Outreach Requested"]
        },
        "emailDispatched": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "programId",
        "university",
        "programTitle",
        "studentName",
        "studentEmail",
        "requirementsAcknowledged",
        "status",
        "emailDispatched",
        "createdAt"
      ]
    },
    "StudentPortalRecord": {
      "title": "StudentPortalRecord",
      "description": "Isolated student portal record tied strictly to the student's exact verified sign-up email and school portal credentials.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentIdNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "portalEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "portalPasswordHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 128
        },
        "university": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "universityLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "course": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sponsorshipProgramme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "grossAnnualFeeUsd": {
          "type": "number"
        },
        "governmentCoveragePercent": {
          "type": "number"
        },
        "governmentCoverageUsd": {
          "type": "number"
        },
        "householdFeeUsd": {
          "type": "number"
        },
        "expectedArrivalDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "intakeTerm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "homeGuardianName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "homeGuardianRelation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "schoolGuardianName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "schoolGuardianRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "workStudyRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "workStudyLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workStudyHourlyUsd": {
          "type": "number"
        },
        "workStudyHoursPerDay": {
          "type": "number"
        },
        "workStudyDaysPerWeek": {
          "type": "number"
        },
        "enrollmentStatus": {
          "type": "string",
          "enum": ["Pre-Arrival", "Enrolled", "Active"]
        },
        "academicTranscript": {
          "type": "array"
        },
        "feesLedger": {
          "type": "array"
        },
        "preArrivalChecklist": {
          "type": "array"
        },
        "studentMail": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "studentEmail",
        "studentName",
        "studentIdNumber",
        "portalEmail",
        "portalPasswordHash",
        "university",
        "universityLocation",
        "course",
        "sponsorshipProgramme",
        "grossAnnualFeeUsd",
        "governmentCoveragePercent",
        "governmentCoverageUsd",
        "householdFeeUsd",
        "expectedArrivalDate",
        "intakeTerm",
        "homeGuardianName",
        "homeGuardianRelation",
        "schoolGuardianName",
        "schoolGuardianRole",
        "workStudyRole",
        "workStudyLocation",
        "workStudyHourlyUsd",
        "workStudyHoursPerDay",
        "workStudyDaysPerWeek",
        "enrollmentStatus",
        "academicTranscript",
        "feesLedger",
        "preArrivalChecklist",
        "studentMail",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile and onboarding preferences owned strictly by userId."
    },
    "/users/{userId}/savedPrograms/{programId}": {
      "schema": { "$ref": "#/entities/SavedProgram" },
      "description": "Student's saved scholarship and work-study tracker entries."
    },
    "/users/{userId}/vaultDocuments/{docId}": {
      "schema": { "$ref": "#/entities/VaultDocument" },
      "description": "Student's personal Document Vault entries."
    },
    "/users/{userId}/applications/{programId}": {
      "schema": { "$ref": "#/entities/ApplicationSubmission" },
      "description": "Student's confirmed school selections with requirements acknowledgement and outreach status."
    },
    "/studentPortals/{portalId}": {
      "schema": { "$ref": "#/entities/StudentPortalRecord" },
      "description": "Per-student institutional portal records keyed by sanitized sign-up email and strictly isolated by verified email ownership."
    }
  }
}
